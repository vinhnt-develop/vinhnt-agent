# Server
APP_HOST=localhost
APP_PORT=8080
APP_API_PREFIX=api
APP_API_DOCUMENT=true
APP_CORS_ORIGIN=http://localhost:5173

# Database (SQLite)
DATABASE_URL=file:./data/agent.db

# Sync (connect to vinhnt-api cloud)
SYNC_API_URL=http://localhost:3000/api/v1
SYNC_API_KEY=
SYNC_ENABLED=false

NODE_ENV=development

# Agent behavior
# auto-approve write/shell tools (default true; set false to require approval UI)
AGENT_AUTO_APPROVAL=true
AGENT_MAX_STEPS=30
AGENT_WORKSPACE_ROOT=.
