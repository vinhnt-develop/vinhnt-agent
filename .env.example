# Server
APP_HOST=
APP_PORT=
APP_API_PREFIX=
APP_API_DOCUMENT=
APP_CORS_ORIGIN=

# Database (SQLite)
DATABASE_URL=

# Sync (connect to vinhnt-api cloud)
SYNC_API_URL=
SYNC_API_KEY=
SYNC_ENABLED=

NODE_ENV=

# Agent behavior
# Fallback hierarchy (P4.6 + SC): config/kernel-settings.json (Settings UI) > env (agent.*) > literal.
# Env values seed the kernel-settings defaults at boot — once kernel-settings.json
# exists and stores a field, that saved value wins over env from then on.
# The 6 knobs marked [UI] below are editable in Settings > Agent (JSON-first):
# env only seeds them; editing in the UI overrides env until you reset.
#
# [UI] ops kill switch (L2): false forces approval for EVERY run — the Settings
# UI cannot bypass it (the UI's own autoApproval toggle is layer L1, checked after).
AGENT_AUTO_APPROVAL=        # default true; false = force 'ask' for all runs
# [UI] fallback project root when a session has no project path
AGENT_WORKSPACE_ROOT=       # default .
# Extra folders exposed by the project-directory picker (GET /fs/*).
# Path-delimiter or comma separated; the home folder and workspace root are
# always browsable. AGENT_BROWSE_HOME overrides the home shortcut only.
AGENT_BROWSE_ROOTS=
AGENT_BROWSE_HOME=
AGENT_TEMPERATURE=        # default 0.7 — seeds kernel-settings temperature
AGENT_TOP_P=              # default 1.0 — seeds kernel-settings topP
AGENT_MAX_STEPS=          # default 30
AGENT_MAX_TOKENS=         # default 4096
AGENT_STEP_TIMEOUT=       # default 120000 (ms)
AGENT_DOOM_LOOP_THRESHOLD=  # default 3
AGENT_THINKING_BUDGET=    # default 1024
# [UI] unanswered approval dialog fails the tool after this window (ms)
AGENT_APPROVAL_TIMEOUT_MS=  # default 120000 (range 1000..600000)
# [UI] kernel LRU cache capacity (applies at next evict, no restart)
AGENT_MAX_KERNEL_CACHE_SIZE=  # default 50 (min 1)
# [UI] OpenCode-style permission rules JSON blob (deep-shape validated by the
# service; bad shapes are dropped with a warning, not applied):
#   AGENT_PERMISSION_RULES={"shell":"ask","read":{".env":"deny"}}
AGENT_PERMISSION_RULES=
# [UI] risk-level → effect defaults JSON blob (merged with destructive:'allow'
# when permission mode is "full"):
#   AGENT_PERMISSION_RISK_DEFAULTS={"destructive":"ask","write":"allow"}
AGENT_PERMISSION_RISK_DEFAULTS=
# [UI] OTLP/HTTP traces endpoint for agent-run spans (P6.4) — OPT-IN:
# empty = disabled (default; no telemetry leaves the process); non-empty must
# be http(s), e.g. http://localhost:4318/v1/traces (OTEL collector).
# Payload = whitelisted metadata only (model/status/tokens/tool names) —
# never prompts, tool inputs, or tool outputs.
AGENT_OTLP_ENDPOINT=

# NOTE: LLM provider API keys (Google, OpenRouter, ...) are NOT stored in .env.
# They live in config/providers.json (Settings -> Providers), either:
#   - pasted directly as plaintext (recommended), or
#   - as an "env:VAR_NAME" reference resolved from this file at boot.
# This file only holds server/database/agent settings (plus SYNC_API_KEY for cloud sync).
